<Grid class="diagnostics-root"
      ColumnDefinitions="320,*">

    <Border class="diagnostics-sidebar">

        <Grid RowDefinitions="Auto,Auto,*">

            <Grid class="diagnostics-brand"
                  ColumnDefinitions="Auto,*">

                <Border class="diagnostics-brand-mark">
                    <TextBlock class="diagnostics-brand-letter"
                               Text="A"/>
                </Border>

                <StackPanel Grid.Column="1"
                            class="diagnostics-brand-copy">
                    <TextBlock class="diagnostics-brand-title"
                               Text="Akbura Diagnostics"/>
                    <TextBlock class="diagnostics-brand-subtitle"
                               Text="Live component inspector"/>
                </StackPanel>

            </Grid>

            <Border Grid.Row="1"
                    class="diagnostics-tree-caption">
                <TextBlock class="diagnostics-tree-caption-text"
                           Text="ATTACHED COMPONENTS"/>
            </Border>

            <TreeView x.Name="componentTree"
                      Grid.Row="2"
                      class="diagnostics-tree"/>

        </Grid>

    </Border>

    <Grid Grid.Column="1"
          class="diagnostics-workspace"
          RowDefinitions="Auto,*">

        <Border class="diagnostics-selection-header">

            <StackPanel class="diagnostics-selection-copy">
                <TextBlock x.Name="selectionTitle"
                           class="diagnostics-selection-title"
                           Text="No component selected"/>
                <TextBlock x.Name="selectionType"
                           class="diagnostics-selection-type"/>
            </StackPanel>

        </Border>

        <ScrollViewer Grid.Row="1"
                      class="diagnostics-details-scroll">
            <StackPanel x.Name="detailsPanel"
                        class="diagnostics-details"/>
        </ScrollViewer>

    </Grid>

</Grid>
