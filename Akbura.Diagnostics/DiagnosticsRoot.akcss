Grid.diagnostics-root {
    Background:
        Amx.DynamicResource<IBrush>(
            "--color-slate-950");
}

Border.diagnostics-sidebar {
    BorderThickness: new Thickness(0d, 0d, 1d, 0d);

    @apply p-5
        bg-slate-900
        border-slate-700;
}

Grid.diagnostics-brand {
    ColumnSpacing: 12d;
}

Border.diagnostics-brand-mark {
    Width: 42d;
    Height: 42d;

    @apply bg-blue-600
        border-1
        border-blue-500
        rounded-lg;
}

TextBlock.diagnostics-brand-letter {
    HorizontalAlignment: HorizontalAlignment.Center;
    VerticalAlignment: VerticalAlignment.Center;

    @apply text-xl
        font-bold
        text-white;
}

StackPanel.diagnostics-brand-copy {
    Spacing: 2d;
    VerticalAlignment: VerticalAlignment.Center;
}

TextBlock.diagnostics-brand-title {
    @apply text-lg
        font-semibold
        text-slate-100;
}

TextBlock.diagnostics-brand-subtitle {
    @apply text-sm
        text-slate-400;
}

Border.diagnostics-tree-caption {
    Margin: new Thickness(0d, 24d, 0d, 8d);
}

TextBlock.diagnostics-tree-caption-text {
    @apply text-xs
        font-semibold
        text-slate-500;
}

TreeView.diagnostics-tree {
    Background: Brushes.Transparent;
    BorderThickness: new Thickness(0d);
}

Grid.diagnostics-workspace {
    Background:
        Amx.DynamicResource<IBrush>(
            "--color-slate-950");
}

Border.diagnostics-selection-header {
    BorderThickness: new Thickness(0d, 0d, 0d, 1d);

    @apply px-6
        py-4
        bg-slate-900
        border-slate-800;
}

StackPanel.diagnostics-selection-copy {
    Spacing: 3d;
}

TextBlock.diagnostics-selection-title {
    @apply text-xl
        font-semibold
        text-slate-100;
}

TextBlock.diagnostics-selection-type {
    TextTrimming: TextTrimming.CharacterEllipsis;

    @apply text-sm
        text-slate-400;
}

ScrollViewer.diagnostics-details-scroll {
    HorizontalScrollBarVisibility: ScrollBarVisibility.Disabled;
    VerticalScrollBarVisibility: ScrollBarVisibility.Auto;
    HorizontalContentAlignment: HorizontalAlignment.Stretch;
}

StackPanel.diagnostics-details {
    MinWidth: 0d;
    Spacing: 20d;
    Margin: new Thickness(24d);
    HorizontalAlignment: HorizontalAlignment.Stretch;
}
