state string url = "/overview";

<DrawerPage Header="Akbura Feature Gallery"
            DrawerLength="260">

    <DrawerPage.Drawer>
        <AppDrawer Router={Router}
                   CurrentUrl={url}/>
    </DrawerPage.Drawer>

    <Grid RowDefinitions="Auto,*"
          bg-slate-950>

        <Border row-1
                p-2
                ${md}:p-4
                bg-slate-950>

            <Border p-3
                    ${md}:p-6
                    bg-slate-900
                    border-1
                    border-slate-800
                    rounded-xl
                    shadow-lg>

                <ScrollViewer>
                    <Router bind:Url={url}
                            x.Name="Router">

                        <Router.NotFound x.DataType="string"
                                         x.ItemName="notFoundUrl">

                            <NotFoundPage Url={notFoundUrl}
                                          Router={Router}/>

                        </Router.NotFound>

                        <Router.Pages>

                            <Page Url="/overview">
                                <OverviewPage/>
                            </Page>

                            <Page Url="/data-templates">
                                <DataTemplatesPage/>
                            </Page>

                            <Page Url="/xml-xaml-axaml">
                                <XmlXamlAxamlPage/>
                            </Page>

                            <Page Url="/about">
                                <AboutPage/>
                            </Page>

                            <Page Url="/akcss">
                                <AkcssPage/>
                            </Page>

                            <Page Url="/utility-variants">
                                <UtilityVariantsPage/>
                            </Page>

                        </Router.Pages>

                    </Router>
                </ScrollViewer>

            </Border>
        </Border>

    </Grid>

</DrawerPage>
