using Akbura.FeatureGallery.Styles.akcss;

state string url = "/pages";

<DrawerPage Header="Akbura Feature Gallery"
            DrawerLength="260">

    <DrawerPage.Drawer>
        <AppDrawer Router={Router}
                   CurrentUrl={url}/>
    </DrawerPage.Drawer>

    <Grid RowDefinitions="Auto,*"
          bg-slate-950>

        <BrowserBar Router={Router}
                    CurrentUrl={url}/>

        <Border row-1
                p-4
                bg-slate-950>

            <Border bg-slate-900
                    border-1
                    border-slate-800
                    rounded-xl
                    shadow-lg
                    p-6>

                <ScrollViewer>
                    <Router bind:Url={url}
                            x.Name="Router">

                        <Router.NotFound x.DataType="string"
                                         x.ItemName="notFoundUrl">

                            <NotFoundPage Url={notFoundUrl}
                                          Router={Router}/>

                        </Router.NotFound>

                        <Router.Pages>

                            <Page Url="/pages">
                                <OverviewPage/>
                            </Page>

                            <Page Url="/data-templates">
                                <DataTemplates/>
                            </Page>

                            <Page Url="/about">
                                <AboutPage/>
                            </Page>

                        </Router.Pages>

                    </Router>
                </ScrollViewer>

            </Border>
        </Border>

    </Grid>

</DrawerPage>