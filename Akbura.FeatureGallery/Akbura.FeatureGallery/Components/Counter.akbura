state int count = 0;

<StackPanel gap-3>

    <TextBlock Text="Akbura Counter"
               text-2xl
               font-bold/>

    <TextBlock Text={$"Current value: {count}"}
               text-base/>

    <StackPanel Orientation="Horizontal"
                gap-2>

        <Button Content="Decrease"
                Click={count--}/>

        <Button Content="Increase"
                Click={count++}/>

    </StackPanel>

    <ViewThisComponentInGithub/>

</StackPanel>