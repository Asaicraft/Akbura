using Akbura.FeatureGallery.Styles.akcss;
using Avalonia.Controls;

state int count = 0;

<StackPanel Spacing="12" bg-blue-100>
    <TextBlock Text={$"Count: {count}"} Background=${StaticResource bg-red-700}/>
    <Button Click={count++} Background=${DynamicResource bg-red-500}>
        Increment to {count+1}
    </Button>
</StackPanel>