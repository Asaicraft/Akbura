using Akbura.FeatureGallery.Styles.akcss;
using Akbura.Hooks;
using AvaloniaEdit;
using AvaloniaEdit.Highlighting;

param IDataTemplate View;
param string Path;
param string Code;

state Control? preview = null;

useEffect(() =>
{
    preview = View.Build(null);
}, [View]);

<Grid RowDefinitions="Auto,*"
      gap-y-4>

    <StackPanel gap-1>

        <TextBlock Text="Feature"
                   text-2xl
                   font-bold
                   text-slate-100/>

        <TextBlock Text={Path}
                   text-sm
                   text-slate-400
                   truncate/>

    </StackPanel>

    <Border row-1
            min-h-96
            bg-slate-950
            border-1
            border-slate-700
            rounded-xl
            overflow-hidden>

        <TabControl>

            <TabItem Header="Preview">

                <Border p-6
                        bg-slate-950>

                    <ContentPresenter Content={preview}
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>

                </Border>

            </TabItem>

            <TabItem Header="Code">

                <Grid RowDefinitions="Auto,*">

                    <Border p-3
                            bg-slate-800>

                        <TextBlock Text={Path}
                                   text-sm
                                   font-medium
                                   text-slate-200
                                   truncate/>

                    </Border>

                    <TextEditor row-1
                        Text={Code}
                        IsReadOnly="True"
                        ShowLineNumbers="True"
                        WordWrap="False"
                        SyntaxHighlighting={
                            HighlightingManager.Instance.GetDefinition("XML")}
                        FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                        FontSize="15"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        bg-slate-950
                        text-slate-200
                        p-4/>

                </Grid>

            </TabItem>

        </TabControl>

    </Border>

</Grid>
