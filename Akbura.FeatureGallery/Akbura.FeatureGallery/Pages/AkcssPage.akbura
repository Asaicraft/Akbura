using Akbura.FeatureGallery.Pages.Page.akcss;
using Akbura.Markup;

<StackPanel page
            ${md}:page-desktop>

    <StackPanel page-header>

        <TextBlock Text="AKCSS"
                   page-title
                   ${md}:page-title-desktop/>

        <TextBlock
            Text="Typed, reactive styles and reusable utilities for Akbura components and Avalonia controls."
            page-description
            ${md}:page-description-desktop/>

    </StackPanel>

    <Grid page-grid-3
          ${lg}:page-grid-3-desktop>

        <Border page-card>

            <StackPanel gap-3>

                <TextBlock Text="Typed"
                           page-card-title/>

                <TextBlock
                    Text="Selectors, properties, values and utility parameters are checked against their target types."
                    page-card-description/>

                <TextBlock Text="Button.primary"
                           page-code/>

            </StackPanel>

        </Border>

        <Border page-cell-2
                ${lg}:page-cell-2-desktop
                page-card>

            <StackPanel gap-3>

                <TextBlock Text="Reactive"
                           page-card-title/>

                <TextBlock
                    Text="Expressions and conditions are reevaluated when their observable dependencies change."
                    page-card-description/>

                <TextBlock Text="@if(IsPointerOver)"
                           page-code/>

            </StackPanel>

        </Border>

        <Border page-cell-3
                ${lg}:page-cell-3-desktop
                page-card>

            <StackPanel gap-3>

                <TextBlock Text="Composable"
                           page-card-title/>

                <TextBlock
                    Text="Small utilities can be combined directly in markup or reused inside styles through @apply."
                    page-card-description/>

                <TextBlock Text="p-4 rounded-xl bg-blue-600"
                           page-code/>

            </StackPanel>

        </Border>

    </Grid>

    <StackPanel page-section>

        <StackPanel page-section-header>

            <TextBlock Text="Try AKCSS"
                       page-section-title
                       ${md}:page-section-title-desktop/>

            <TextBlock
                Text="This example demonstrates a reactive class, @apply, custom utilities, typed parameters and conditional utilities."
                page-section-description/>

        </StackPanel>

        <FeatureView Path="Components/AkcssDemo.akbura">

            <FeatureView.Code>
                {"""
                using Akbura.FeatureGallery.Styles.akcss;

                state bool isHighlighted = false;

                @akcss {
                    @using Akbura.FeatureGallery.Styles.akcss;

                    Button.reactive-button {
                        @apply bg-blue-600 text-white
                               px-4 py-2 rounded-lg
                               font-semibold;

                        @if(IsPointerOver) {
                            @apply bg-blue-500 px-5 py-3;
                        }
                    }

                    @utilities {
                        Border.demo-surface {
                            @apply bg-slate-800
                                   border-1
                                   border-slate-700
                                   rounded-lg;
                        }

                        Control.square-(double size) {
                            Width: size;
                            Height: size;
                        }
                    }
                }

                <StackPanel gap-5>

                    <Button class="reactive-button"
                            HorizontalAlignment="Left"
                            Click={() =>
                                isHighlighted = !isHighlighted}>

                        {isHighlighted
                            ? "Disable highlight"
                            : "Enable highlight"}

                    </Button>

                    <Border demo-surface
                            p-4
                            {isHighlighted}:border-blue-500
                            {isHighlighted}:shadow-lg>

                        <Grid ColumnDefinitions="Auto,*"
                              gap-x-4>

                            <Border square-48
                                    bg-blue-600
                                    rounded-lg/>

                            <TextBlock col-1
                                       Text="Utility composition"
                                       self-center/>

                        </Grid>

                    </Border>

                    <Border demo-surface
                            p-3
                            pt-2>

                        Composable spacing

                    </Border>

                </StackPanel>
                """}
            </FeatureView.Code>

            <FeatureView.View>
                <AkcssDemo/>
            </FeatureView.View>

        </FeatureView>

    </StackPanel>

    <StackPanel page-section>

        <StackPanel page-section-header>

            <TextBlock Text="Markup extension utilities"
                       page-section-title
                       ${md}:page-section-title-desktop/>

            <TextBlock
                Text="Utility arguments can come from markup extensions, while reactive extension prefixes participate in the AKCSS cascade."
                page-section-description/>

        </StackPanel>

        <FeatureView Path="Components/MarkupExtensionUtilityDemo.akbura">

            <FeatureView.Code>
                {"""
                using Akbura.FeatureGallery.Markup;
                using Akbura.FeatureGallery.Styles.akcss;

                state double spacing = 3;

                <StackPanel gap-3>
                    <StackPanel Orientation="Horizontal"
                                gap-2>
                        <Button Content="-"
                                Click={() =>
                                    spacing = Math.Max(1, spacing - 1)}/>

                        <Button Content="+"
                                Click={() =>
                                    spacing = Math.Min(8, spacing + 1)}/>
                    </StackPanel>

                    <Border p-${GalleryPadding {spacing}}
                            bg-blue-600
                            rounded-lg>
                        Dynamic utility argument
                    </Border>
                </StackPanel>
                """}
            </FeatureView.Code>

            <FeatureView.View>
                <MarkupExtensionUtilityDemo/>
            </FeatureView.View>

        </FeatureView>

        <FeatureView Path="Components/BreakpointUtilityDemo.akbura">

            <FeatureView.Code>
                {"""
                using Akbura.FeatureGallery.Styles.akcss;
                using Akbura.Markup;

                <Border p-1
                        ${sm}:p-2
                        ${md}:p-3
                        ${lg}:p-4
                        ${xl}:p-5
                        ${xxl}:p-6>
                    Resize the window
                </Border>
                """}
            </FeatureView.Code>

            <FeatureView.View>
                <BreakpointUtilityDemo/>
            </FeatureView.View>

        </FeatureView>

    </StackPanel>

    <StackPanel page-section>

        <TextBlock Text="Classes and utilities"
                   page-section-title
                   ${md}:page-section-title-desktop/>

        <Grid page-grid-2
              ${md}:page-grid-2-desktop>

            <Border page-card>

                <StackPanel gap-3>

                    <TextBlock Text="AKCSS class"
                               page-card-title/>

                    <TextBlock
                        Text="A named collection of declarations applied through the lowercase class attribute."
                        page-card-description/>

                    <Border page-code-surface>

                        <TextBlock
                            Text={"<Button class=\"primary\" />"}
                            page-code/>

                    </Border>

                </StackPanel>

            </Border>

            <Border page-cell-2
                    ${md}:page-cell-2-desktop
                    page-card>

                <StackPanel gap-3>

                    <TextBlock Text="AKCSS utility"
                               page-card-title/>

                    <TextBlock
                        Text="A small typed style applied directly as a markup attribute without class."
                        page-card-description/>

                    <Border page-code-surface>

                        <TextBlock
                            Text={"<Button p-4 rounded-lg />"}
                            page-code/>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>

        <Border page-note>

            <TextBlock
                Text="The lowercase class attribute applies AKCSS classes. Avalonia's Classes property continues to use standard Avalonia style classes."
                page-note-text/>

        </Border>

    </StackPanel>

    <StackPanel page-section>

        <TextBlock Text="Composing styles with @apply"
                   page-section-title
                   ${md}:page-section-title-desktop/>

        <Border page-card>

            <Grid page-flow-2
                  ${md}:page-flow-2-desktop>

                <StackPanel gap-2>

                    <TextBlock Text="Utilities"
                               page-card-small-title/>

                    <TextBlock
                        Text="bg-blue-600 text-white px-4 py-2 rounded-lg"
                        page-code/>

                </StackPanel>

                <TextBlock
                    Text="->"
                    page-flow-arrow
                    ${md}:page-flow-arrow-1-desktop
                    text-2xl
                    text-slate-500
                    self-center/>

                <StackPanel page-flow-second
                            ${md}:page-flow-second-desktop
                            gap-2>

                    <TextBlock Text="Reusable class"
                               page-card-small-title/>

                    <TextBlock
                        Text="@apply bg-blue-600 text-white px-4 py-2 rounded-lg;"
                        page-code/>

                </StackPanel>

            </Grid>

        </Border>

        <TextBlock
            Text="@apply copies compatible declarations from existing classes and utilities into the current AKCSS rule."
            page-card-description/>

    </StackPanel>

    <StackPanel page-section>

        <TextBlock Text="Reactive cascade"
                   page-section-title
                   ${md}:page-section-title-desktop/>

        <Grid page-flow-2
              ${md}:page-flow-2-desktop>

            <Border page-card>

                <StackPanel gap-2>

                    <TextBlock Text="Regular declaration"
                               page-card-small-title/>

                    <TextBlock Text="@apply bg-blue-600;"
                               page-code/>

                    <TextBlock Text="BindingPriority.Style"
                               page-card-description/>

                </StackPanel>

            </Border>

            <TextBlock
                Text="->"
                page-flow-arrow
                ${md}:page-flow-arrow-1-desktop
                text-2xl
                text-slate-500
                self-center/>

            <Border page-flow-second
                    ${md}:page-flow-second-desktop
                    page-card-accent>

                <StackPanel gap-2>

                    <TextBlock Text="Active @if declaration"
                               page-card-small-title/>

                    <TextBlock Text="@apply bg-blue-500;"
                               page-code/>

                    <TextBlock Text="BindingPriority.StyleTrigger"
                               page-card-description/>

                </StackPanel>

            </Border>

        </Grid>

        <TextBlock
            Text="When the condition becomes false, AKCSS removes the trigger values and exposes the regular style values again."
            page-card-description/>

    </StackPanel>

    <StackPanel page-section>

        <TextBlock Text="Utility arguments"
                   page-section-title
                   ${md}:page-section-title-desktop/>

        <Grid page-grid-2
              ${md}:page-grid-2-desktop>

            <Border page-card>

                <StackPanel gap-3>

                    <TextBlock Text="Parameterized utility"
                               page-card-title/>

                    <TextBlock
                        Text="Parameters are declared using normal C# types and passed through utility name segments."
                        page-card-description/>

                    <Border page-code-surface>

                        <StackPanel gap-2>

                            <TextBlock
                                Text="Control.square-(double size)"
                                page-code/>

                            <TextBlock
                                Text={"<Border square-48 />"}
                                page-code
                                text-slate-300/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

            <Border page-cell-2
                    ${md}:page-cell-2-desktop
                    page-card>

                <StackPanel gap-3>

                    <TextBlock Text="Conditional utility"
                               page-card-title/>

                    <TextBlock
                        Text="A boolean C# expression before the colon controls whether a utility is applied."
                        page-card-description/>

                    <Border page-code-surface>

                        <TextBlock
                            Text={"<Border {isActive}:border-blue-500 />"}
                            page-code/>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>

    </StackPanel>

    <StackPanel page-section>

        <TextBlock Text="Where styles are resolved"
                   page-section-title
                   ${md}:page-section-title-desktop/>

        <Grid page-flow-3
              ${lg}:page-flow-3-desktop>

            <Border page-card-compact>

                <StackPanel gap-1>

                    <TextBlock Text="1"
                               text-sm
                               text-blue-400/>

                    <TextBlock Text="Inline @akcss"
                               font-semibold
                               text-slate-100/>

                    <TextBlock Text="Current component"
                               page-card-description/>

                </StackPanel>

            </Border>

            <TextBlock
                Text="->"
                page-flow-arrow
                ${lg}:page-flow-arrow-1-desktop
                text-xl
                text-slate-500
                self-center/>

            <Border page-flow-second
                    ${lg}:page-flow-second-desktop
                    page-card-compact>

                <StackPanel gap-1>

                    <TextBlock Text="2"
                               text-sm
                               text-blue-400/>

                    <TextBlock Text="Companion file"
                               font-semibold
                               text-slate-100/>

                    <TextBlock Text="ComponentName.akcss"
                               page-card-description/>

                </StackPanel>

            </Border>

            <TextBlock
                Text="->"
                page-flow-arrow
                ${lg}:page-flow-arrow-2-desktop
                text-xl
                text-slate-500
                self-center/>

            <Border page-flow-third
                    ${lg}:page-flow-third-desktop
                    page-card-compact>

                <StackPanel gap-1>

                    <TextBlock Text="3"
                               text-sm
                               text-blue-400/>

                    <TextBlock Text="Imported modules"
                               font-semibold
                               text-slate-100/>

                    <TextBlock Text="Resolved in using order"
                               page-card-description/>

                </StackPanel>

            </Border>

        </Grid>

    </StackPanel>

    <StackPanel page-section>

        <TextBlock Text="Composable spacing"
                   page-section-title
                   ${md}:page-section-title-desktop/>

        <Border page-card>

            <Grid page-flow-2
                  ${md}:page-flow-2-desktop>

                <StackPanel gap-1>

                    <TextBlock Text="p-3"
                               text-lg
                               text-blue-400
                               FontFamily="Cascadia Code,Consolas,Monospace"/>

                    <TextBlock Text="12 on every side"
                               page-card-description/>

                </StackPanel>

                <TextBlock
                    Text="+"
                    page-flow-arrow
                    ${md}:page-flow-arrow-1-desktop
                    text-xl
                    text-slate-500
                    self-center/>

                <StackPanel page-flow-second
                            ${md}:page-flow-second-desktop
                            gap-1>

                    <TextBlock Text="pt-2"
                               text-lg
                               text-blue-400
                               FontFamily="Cascadia Code,Consolas,Monospace"/>

                    <TextBlock
                        Text="Top becomes 8 while left, right and bottom remain 12."
                        page-card-description/>

                </StackPanel>

            </Grid>

        </Border>

    </StackPanel>

    <ViewThisPageInGithub/>

</StackPanel>
