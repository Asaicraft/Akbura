using Akbura.FeatureGallery.Pages.Page.akcss;
using Akbura.Markup;

<StackPanel page
            ${md}:page-desktop>

    <StackPanel page-header>

        <TextBlock Text="Data templates"
                   page-title
                   ${md}:page-title-desktop/>

        <TextBlock
            Text="Create strongly typed visual templates using compiled bindings, direct C# expressions and deferred content."
            page-description
            ${md}:page-description-desktop/>

    </StackPanel>

    <Grid page-grid-2
          ${md}:page-grid-2-desktop>

        <Border page-card>

            <StackPanel gap-3>

                <TextBlock Text="IDataTemplate"
                           page-card-title/>

                <TextBlock
                    Text="Describes how one data item is converted into a new control tree."
                    page-card-description/>

                <Border page-code-surface-inline>

                    <TextBlock Text="item -> Build(item) -> Control"
                               page-code/>

                </Border>

            </StackPanel>

        </Border>

        <Border page-cell-2
                ${md}:page-cell-2-desktop
                page-card>

            <StackPanel gap-3>

                <TextBlock Text="IDeferredContent"
                           page-card-title/>

                <TextBlock
                    Text="Stores a control factory so the markup can be created later rather than immediately."
                    page-card-description/>

                <Border page-code-surface-inline>

                    <TextBlock Text="markup -> factory -> Build later"
                               page-code/>

                </Border>

            </StackPanel>

        </Border>

    </Grid>

    <StackPanel page-section>

        <StackPanel page-section-header>

            <TextBlock Text="Implicit and explicit templates"
                       page-section-title
                       ${md}:page-section-title-desktop/>

            <TextBlock
                Text="Both forms create the same visible result, but they use different generated representations."
                page-section-description/>

        </StackPanel>

        <FeatureView Path="Components/DataTemplates.akbura">

            <FeatureView.Code>
                {"""
                using System.Collections.Immutable;

                state ImmutableArray<(string Name, int Age)> persons =
                [
                    ("Alice", 18),
                    ("Bob", 19),
                    ("Charlie", 24),
                    ("Diana", 31)
                ];

                <Grid ColumnDefinitions="*,*"
                      gap-x-4>

                    <ItemsControl ItemsSource={persons}>

                        <ItemsControl.ItemTemplate x.ItemName="person">

                            <StackPanel>
                                <TextBlock Text={person.Name}/>

                                <TextBlock
                                    Text={$"{person.Age} years"}/>
                            </StackPanel>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <ItemsControl ItemsSource={persons}
                                  col-1>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <StackPanel>
                                    <TextBlock Text=${Binding Name}/>

                                    <TextBlock
                                        Text=${Binding Age, StringFormat="{0} years"}/>
                                </StackPanel>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>
                """}
            </FeatureView.Code>

            <FeatureView.View>
                <DataTemplates/>
            </FeatureView.View>

        </FeatureView>

    </StackPanel>

    <StackPanel page-section>

        <TextBlock Text="What Akbura generates"
                   page-section-title
                   ${md}:page-section-title-desktop/>

        <Grid page-grid-3
              ${lg}:page-grid-3-desktop>

            <Border page-card>

                <StackPanel gap-2>

                    <TextBlock Text="1. Infer the item type"
                               page-card-small-title/>

                    <TextBlock
                        Text="The compiler examines the static type of ItemsSource and obtains the collection item type."
                        page-card-description/>

                    <TextBlock
                        Text="ImmutableArray<(string, int)>"
                        page-code/>

                </StackPanel>

            </Border>

            <Border page-cell-2
                    ${lg}:page-cell-2-desktop
                    page-card>

                <StackPanel gap-2>

                    <TextBlock Text="2. Create a template"
                               page-card-small-title/>

                    <TextBlock
                        Text="A direct control is wrapped in FuncDataTemplate. An explicit DataTemplate remains an Avalonia DataTemplate."
                        page-card-description/>

                    <TextBlock Text="FuncDataTemplate"
                               page-code/>

                </StackPanel>

            </Border>

            <Border page-cell-3
                    ${lg}:page-cell-3-desktop
                    page-card>

                <StackPanel gap-2>

                    <TextBlock Text="3. Build each item"
                               page-card-small-title/>

                    <TextBlock
                        Text="ItemsControl calls the template for every item and receives a fresh control tree."
                        page-card-description/>

                    <TextBlock Text="template.Build(item)"
                               page-code/>

                </StackPanel>

            </Border>

        </Grid>

    </StackPanel>

    <StackPanel page-section>

        <StackPanel page-section-header>

            <TextBlock Text="How IDeferredContent works"
                       page-section-title
                       ${md}:page-section-title-desktop/>

            <TextBlock
                Text="IDeferredContent prevents a template body from being instantiated before it is actually needed."
                page-section-description/>

        </StackPanel>

        <FeatureView Path="Components/Page.cs + Components/Router.akbura">

            <FeatureView.Code>
                {"""
                public sealed class Page
                {
                    public string Url { get; set; } = null!;

                    [Content]
                    [TemplateContent]
                    public object Content { get; set; } = null!;
                }

                <Page Url="/about">
                    <AboutPage/>
                </Page>

                content = page == null
                    ? NotFound.Build(Url)
                    : TemplateContent
                        .Load<Control>(page.Content)
                        .Result;
                """}
            </FeatureView.Code>

            <FeatureView.View>

                <Grid page-flow-3
                      ${lg}:page-flow-3-desktop
                      self-center>

                    <Border page-card-compact>

                        <StackPanel gap-2>

                            <TextBlock Text="Markup"
                                       page-card-small-title
                                       text-center/>

                            <TextBlock Text="<AboutPage/>"
                                       page-code
                                       text-center/>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        Text="->"
                        page-flow-arrow
                        ${lg}:page-flow-arrow-1-desktop
                        text-2xl
                        text-slate-500
                        self-center/>

                    <Border page-flow-second
                            ${lg}:page-flow-second-desktop
                            page-card-compact>

                        <StackPanel gap-2>

                            <TextBlock Text="Deferred factory"
                                       page-card-small-title
                                       text-center/>

                            <TextBlock Text="IDeferredContent"
                                       page-code
                                       text-center/>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        Text="->"
                        page-flow-arrow
                        ${lg}:page-flow-arrow-2-desktop
                        text-2xl
                        text-slate-500
                        self-center/>

                    <Border page-flow-third
                            ${lg}:page-flow-third-desktop
                            page-card-compact>

                        <StackPanel gap-2>

                            <TextBlock Text="Built later"
                                       page-card-small-title
                                       text-center/>

                            <TextBlock Text="TemplateContent.Load"
                                       page-code
                                       text-center/>

                        </StackPanel>

                    </Border>

                </Grid>

            </FeatureView.View>

        </FeatureView>

    </StackPanel>

    <Border page-callout>

        <StackPanel gap-2>

            <TextBlock Text="IDataTemplate and IDeferredContent are not the same thing"
                       page-card-title/>

            <TextBlock
                Text="IDataTemplate describes how data becomes a control. IDeferredContent stores the factory for a deferred section of markup. An explicit DataTemplate uses both: the DataTemplate itself implements IDataTemplate, while its Content is represented by IDeferredContent."
                page-card-description/>

        </StackPanel>

    </Border>

    <ViewThisPageInGithub/>

</StackPanel>
