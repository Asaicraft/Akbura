using Akbura.FeatureGallery.Pages.Page.akcss;

<StackPanel page>

    <Border page-hero>

        <Grid ColumnDefinitions="*,Auto"
              gap-x-8>

            <StackPanel gap-4>

                <TextBlock Text="Build Avalonia interfaces with C#"
                           page-hero-title/>

                <TextBlock
                    Text="Akbura combines declarative markup, reactive state and strongly typed C# in a single component."
                    page-hero-description/>

                <StackPanel Orientation="Horizontal"
                            gap-3>

                    <Border page-badge-primary>

                        <TextBlock Text="Compiled"
                                   page-badge-text-primary/>

                    </Border>

                    <Border page-badge>

                        <TextBlock Text="Reactive"
                                   page-badge-text/>

                    </Border>

                    <Border page-badge>

                        <TextBlock Text="Type-safe"
                                   page-badge-text/>

                    </Border>

                </StackPanel>

            </StackPanel>

            <Border col-1
                    p-6
                    bg-slate-900
                    border-1
                    border-slate-700
                    rounded-xl
                    self-center>

                <StackPanel gap-2>

                    <TextBlock Text="Akbura"
                               text-3xl
                               font-bold
                               text-blue-400
                               text-center/>

                    <TextBlock Text=".akbura"
                               text-sm
                               text-slate-500
                               text-center/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

    <StackPanel page-section>

        <TextBlock Text="Why Akbura?"
                   page-section-title/>

        <Grid ColumnDefinitions="*,*,*"
              gap-x-4>

            <Border page-card>

                <StackPanel gap-3>

                    <TextBlock Text="Reactive state"
                               page-card-title/>

                    <TextBlock
                        Text="Declare state directly inside the component. The interface updates when its value changes."
                        page-card-description/>

                    <TextBlock Text="state int count = 0;"
                               page-code/>

                </StackPanel>

            </Border>

            <Border col-1
                    page-card>

                <StackPanel gap-3>

                    <TextBlock Text="Native C#"
                               page-card-title/>

                    <TextBlock
                        Text="Use normal C# expressions, methods, types and lambdas without introducing a separate scripting language."
                        page-card-description/>

                    <TextBlock Text="Click={() => count++}"
                               page-code/>

                </StackPanel>

            </Border>

            <Border col-2
                    page-card>

                <StackPanel gap-3>

                    <TextBlock Text="AKCSS utilities"
                               page-card-title/>

                    <TextBlock
                        Text="Compose reusable styles with compact utilities while keeping access to Avalonia properties."
                        page-card-description/>

                    <TextBlock Text="p-4 rounded-xl text-lg"
                               page-code/>

                </StackPanel>

            </Border>

        </Grid>

    </StackPanel>

    <StackPanel page-section>

        <StackPanel page-section-header>

            <TextBlock Text="Try it"
                       page-section-title/>

            <TextBlock
                Text="Switch between the live preview and its Akbura source code."
                page-section-description/>

        </StackPanel>

        <FeatureView Path="Components/Counter.akbura">

            <FeatureView.Code>
                {"""
                state int count = 0;

                <StackPanel gap-3>
                    <TextBlock Text="Akbura Counter"
                               text-2xl
                               font-bold/>

                    <TextBlock Text={$"Current value: {count}"}
                               text-base/>

                    <StackPanel Orientation="Horizontal"
                                gap-2>

                        <Button Content="Decrease"
                                Click={count--}/>

                        <Button Content="Increase"
                                Click={count++}/>

                    </StackPanel>
                </StackPanel>
                """}
            </FeatureView.Code>

            <FeatureView.View>
                <Counter/>
            </FeatureView.View>

        </FeatureView>

    </StackPanel>

    <ViewThisPageInGithub/>

</StackPanel>