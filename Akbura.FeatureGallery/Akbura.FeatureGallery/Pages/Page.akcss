@using Akbura.Styles.akcss;
@using Avalonia.Controls;
@using Akbura.FeatureGallery.Markup;

@utilities {

    /*
     * Page typography and spacing
     */

    StackPanel.page {
        @apply gap-6;
    }

    StackPanel.page-desktop {
        @apply gap-8;
    }

    StackPanel.page-header {
        @apply gap-2;
    }

    TextBlock.page-title {
        @apply text-3xl
               font-bold
               text-slate-100;
    }

    TextBlock.page-title-desktop {
        @apply text-4xl;
    }

    TextBlock.page-description {
        @apply text-base
               text-slate-400
               whitespace-normal
               self-start;

        MaxWidth: 840;
    }

    TextBlock.page-description-desktop {
        @apply text-lg;
    }

    Border.page-hero {
        @apply p-4
               bg-slate-950
               border-1
               border-slate-800
               rounded-2xl
               overflow-hidden;
    }

    Border.page-hero-desktop {
        @apply p-8;
    }

    TextBlock.page-hero-title {
        @apply text-3xl
               font-bold
               text-slate-100
               whitespace-normal;
    }

    TextBlock.page-hero-title-desktop {
        @apply text-5xl;
    }

    TextBlock.page-hero-description {
        @apply text-base
               text-slate-400
               whitespace-normal
               self-start;

        MaxWidth: 720;
    }

    TextBlock.page-hero-description-desktop {
        @apply text-lg;
    }

    StackPanel.page-section {
        @apply gap-4;
    }

    StackPanel.page-section-header {
        @apply gap-1;
    }

    TextBlock.page-section-title {
        @apply text-2xl
               font-bold
               text-slate-100;
    }

    TextBlock.page-section-title-desktop {
        @apply text-3xl;
    }

    TextBlock.page-section-description {
        @apply text-base
               text-slate-400
               whitespace-normal;
    }

    /*
     * Surfaces
     */

    Border.page-card {
        @apply p-5
               bg-slate-900
               border-1
               border-slate-800
               rounded-xl;
    }

    Border.page-card-accent {
        @apply p-5
               bg-slate-900
               border-1
               border-blue-600
               rounded-xl;
    }

    Border.page-card-compact {
        @apply p-4
               bg-slate-900
               border-1
               border-slate-700
               rounded-xl;
    }

    Border.page-callout {
        @apply p-5
               bg-slate-950
               border-1
               border-slate-700
               rounded-xl;
    }

    Border.page-note {
        @apply p-4
               bg-slate-950
               border-1
               border-slate-700
               rounded-xl;
    }

    TextBlock.page-card-title {
        @apply text-xl
               font-semibold
               text-slate-100;
    }

    TextBlock.page-card-small-title {
        @apply text-lg
               font-semibold
               text-slate-100;
    }

    TextBlock.page-card-description {
        @apply text-sm
               text-slate-400
               whitespace-normal;
    }

    TextBlock.page-note-text {
        @apply text-sm
               text-slate-300
               whitespace-normal;
    }

    Border.page-code-surface {
        @apply p-3
               bg-slate-950
               rounded-lg;
    }

    Border.page-code-surface-inline {
        @apply px-3
               py-2
               bg-slate-950
               rounded-lg;
    }

    TextBlock.page-code {
        @apply text-sm
               text-blue-400
               whitespace-normal;

        FontFamily: "Cascadia Code,Consolas,Monospace";
    }

    Border.page-badge {
        @apply px-3
               py-2
               bg-slate-800
               rounded-lg;
    }

    Border.page-badge-primary {
        @apply px-3
               py-2
               bg-blue-600
               rounded-lg;
    }

    TextBlock.page-badge-text {
        @apply text-sm
               font-semibold
               text-slate-200;
    }

    TextBlock.page-badge-text-primary {
        @apply text-sm
               font-semibold
               text-slate-100;
    }

    /*
     * Responsive two-column layout
     */

    Grid.page-grid-2 {
        ResponsiveGrid.ColumnDefinitions:
            new ColumnDefinitions("*");

        ResponsiveGrid.RowDefinitions:
            new RowDefinitions("Auto,Auto");

        ColumnSpacing: 0d;
        RowSpacing: 16d;
    }

    Grid.page-grid-2-desktop {
        ResponsiveGrid.ColumnDefinitions:
            new ColumnDefinitions("*,*");

        ResponsiveGrid.RowDefinitions:
            new RowDefinitions("Auto");

        ColumnSpacing: 16d;
        RowSpacing: 0d;
    }

    Control.page-cell-2 {
        Grid.Row: 1;
        Grid.Column: 0;
    }

    Control.page-cell-2-desktop {
        Grid.Row: 0;
        Grid.Column: 1;
    }

    /*
     * Responsive three-column layout
     */

    Grid.page-grid-3 {
        ResponsiveGrid.ColumnDefinitions:
            new ColumnDefinitions("*");

        ResponsiveGrid.RowDefinitions:
            new RowDefinitions("Auto,Auto,Auto");

        ColumnSpacing: 0d;
        RowSpacing: 16d;
    }

    Grid.page-grid-3-desktop {
        ResponsiveGrid.ColumnDefinitions:
            new ColumnDefinitions("*,*,*");

        ResponsiveGrid.RowDefinitions:
            new RowDefinitions("Auto");

        ColumnSpacing: 16d;
        RowSpacing: 0d;
    }

    Control.page-cell-3 {
        Grid.Row: 2;
        Grid.Column: 0;
    }

    Control.page-cell-3-desktop {
        Grid.Row: 0;
        Grid.Column: 2;
    }

    /*
     * Responsive hero
     */

    Grid.page-hero-grid {
        ResponsiveGrid.ColumnDefinitions:
            new ColumnDefinitions("*");

        ResponsiveGrid.RowDefinitions:
            new RowDefinitions("Auto,Auto");

        ColumnSpacing: 0d;
        RowSpacing: 16d;
    }

    Grid.page-hero-grid-desktop {
        ResponsiveGrid.ColumnDefinitions:
            new ColumnDefinitions("*,Auto");

        ResponsiveGrid.RowDefinitions:
            new RowDefinitions("Auto");

        ColumnSpacing: 32d;
        RowSpacing: 0d;
    }

    /*
     * Responsive two-step flow
     */

    Grid.page-flow-2 {
        ResponsiveGrid.ColumnDefinitions:
            new ColumnDefinitions("*");

        ResponsiveGrid.RowDefinitions:
            new RowDefinitions("Auto,Auto");

        ColumnSpacing: 0d;
        RowSpacing: 16d;
    }

    Grid.page-flow-2-desktop {
        ResponsiveGrid.ColumnDefinitions:
            new ColumnDefinitions("*,Auto,*");

        ResponsiveGrid.RowDefinitions:
            new RowDefinitions("Auto");

        ColumnSpacing: 16d;
        RowSpacing: 0d;
    }

    Control.page-flow-second {
        Grid.Row: 1;
        Grid.Column: 0;
    }

    Control.page-flow-second-desktop {
        Grid.Row: 0;
        Grid.Column: 2;
    }

    Control.page-flow-arrow {
        IsVisible: false;
    }

    Control.page-flow-arrow-1-desktop {
        IsVisible: true;
        Grid.Row: 0;
        Grid.Column: 1;
    }

    /*
     * Responsive three-step flow
     */

    Grid.page-flow-3 {
        ResponsiveGrid.ColumnDefinitions:
            new ColumnDefinitions("*");

        ResponsiveGrid.RowDefinitions:
            new RowDefinitions("Auto,Auto,Auto");

        ColumnSpacing: 0d;
        RowSpacing: 16d;
    }

    Grid.page-flow-3-desktop {
        ResponsiveGrid.ColumnDefinitions:
            new ColumnDefinitions("*,Auto,*,Auto,*");

        ResponsiveGrid.RowDefinitions:
            new RowDefinitions("Auto");

        ColumnSpacing: 12d;
        RowSpacing: 0d;
    }

    Control.page-flow-third {
        Grid.Row: 2;
        Grid.Column: 0;
    }

    Control.page-flow-third-desktop {
        Grid.Row: 0;
        Grid.Column: 4;
    }

    Control.page-flow-arrow-2-desktop {
        IsVisible: true;
        Grid.Row: 0;
        Grid.Column: 3;
    }
}
