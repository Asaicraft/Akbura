<Project>
	<PropertyGroup>
		<AvaloniaVersion>12.0.4</AvaloniaVersion>
		<AkburaVersion>$(AvaloniaVersion)</AkburaVersion>
		<Version>$(AkburaVersion)</Version>
		<Authors>Asaicraft</Authors>
		<Company>Asaicraft</Company>
		<Copyright>Copyright © 2025-2026 Asaicraft</Copyright>
		<PackageProjectUrl>https://asaicraft.github.io/Akbura/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Asaicraft/Akbura</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<Configurations>Debug;Release;DebugStats;ReleaseStats</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugStats'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'ReleaseStats'">
		<DebugSymbols>false</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
	</PropertyGroup>
</Project>
