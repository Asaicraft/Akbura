{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AKCSS",
  "scopeName": "source.akcss",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#rawStrings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#selectors"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.akcss",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.akcss",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "rawStrings": {
      "patterns": [
        {
          "name": "string.quoted.other.raw.akcss",
          "begin": "(\\$*)(\"{3,})",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.interpolated.akcss"
            },
            "2": {
              "name": "punctuation.definition.string.begin.akcss"
            }
          },
          "end": "\\2",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.akcss"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.akcss",
          "begin": "(?:\\$@|@\\$|\\$|@)?\"",
          "end": "\"",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.akcss"
            },
            {
              "match": "\\{+|\\}+",
              "name": "punctuation.section.embedded.akcss"
            }
          ]
        },
        {
          "name": "string.quoted.single.akcss",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.akcss"
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "@(?:using|utilities|apply|if|intercept|akcss)\\b",
          "name": "keyword.control.directive.akcss"
        }
      ]
    },
    "selectors": {
      "patterns": [
        {
          "match": "(^|[\\s,>])([A-Z][A-Za-z0-9_.]*)(?=\\.)",
          "captures": {
            "2": {
              "name": "entity.name.type.class.akcss"
            }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_])\\.[A-Za-z_][A-Za-z0-9_-]*",
          "name": "entity.other.attribute-name.class.akcss"
        },
        {
          "match": "(?<![A-Za-z0-9_])@[A-Za-z_][A-Za-z0-9_-]*",
          "name": "keyword.control.modifier.akcss"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?(?=\\s*:)",
          "name": "variable.other.property.akcss"
        },
        {
          "match": "\\b(?:left|top|right|bottom|horizontal|vertical)(?=\\s*:)",
          "name": "variable.other.label.akcss"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:using|new|if|else|return|true|false|null|default|typeof|var|void|int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|string|char|bool|object|this|base)\\b",
          "name": "keyword.control.akcss"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[fFdDmMuUlL]*)\\b",
          "name": "constant.numeric.akcss"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "=>|==|!=|<=|>=|&&|\\|\\||\\?\\?|\\+\\+|--|[+\\-*/%=&|!<>?:]",
          "name": "keyword.operator.akcss"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}()\\[\\],.;]",
          "name": "punctuation.separator.akcss"
        }
      ]
    }
  }
}
