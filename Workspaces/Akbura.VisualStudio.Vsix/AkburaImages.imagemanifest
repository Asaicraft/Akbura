		</Image>

		<Image
            Guid="$(AkburaImagesGuid)"
            ID="$(AkcssFile)"
            AllowColorInversion="false">

			<Source Uri="$(Resources)/akcss_64.png">
				<Size Value="64" />
			</Source>
		</Image>
	</Images>

	<ImageLists />
</ImageManifest>