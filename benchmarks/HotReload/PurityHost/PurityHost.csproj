<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AkburaRepositoryRoot>$(MSBuildThisFileDirectory)../../..</AkburaRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <ProjectReference Include="../PurityUIDashborad/PurityUIDashborad.csproj" />
    <Reference Include="Akbura" HintPath="$(AkburaRepositoryRoot)/src/Akbura/bin/Debug/net10.0/Akbura.dll" />
  </ItemGroup>
</Project>
