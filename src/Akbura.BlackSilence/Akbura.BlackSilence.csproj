<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
		<IsRoslynComponent>true</IsRoslynComponent>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<PackageType>Analyzer</PackageType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<RootNamespace>Akbura.BlackSilence</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetBlackSilenceDependencyTargetPaths</GetTargetPathDependsOn>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackBlackSilenceCompiler</TargetsForTfmSpecificContentInPackage>
		<Configurations>Debug;Release;DebugStats;ReleaseStats</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(EnableAkburaStats)' == 'true' Or '$(Configuration)' == 'DebugStats' Or '$(Configuration)' == 'ReleaseStats'">
		<DefineConstants>$(DefineConstants);STATS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PolySharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Akbura.Generator\Akbura.Generator.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

	<Target Name="GetBlackSilenceDependencyTargetPaths">
		<MSBuild Projects="..\Akbura.Generator\Akbura.Generator.csproj" Targets="GetTargetPathWithTargetPlatformMoniker" BuildInParallel="$(BuildInParallel)" Properties="Configuration=$(Configuration);Platform=$(Platform)">
			<Output TaskParameter="TargetOutputs" ItemName="_BlackSilenceDependencyTargetPath" />
		</MSBuild>

		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Include="@(_BlackSilenceDependencyTargetPath)">
				<IncludeRuntimeDependency>false</IncludeRuntimeDependency>
			</TargetPathWithTargetPlatformMoniker>
		</ItemGroup>
	</Target>

	<Target Name="PackBlackSilenceCompiler" DependsOnTargets="ResolveProjectReferences">
		<ItemGroup>
			<TfmSpecificPackageFile
				Include="$(TargetPath)"
				PackagePath="analyzers/dotnet/cs/Akbura.BlackSilence.dll" />
			<TfmSpecificPackageFile
				Include="..\Akbura.Generator\bin\$(Configuration)\netstandard2.0\Akbura.Generator.dll"
				PackagePath="analyzers/dotnet/cs/Akbura.Generator.dll" />
		</ItemGroup>
	</Target>

</Project>
