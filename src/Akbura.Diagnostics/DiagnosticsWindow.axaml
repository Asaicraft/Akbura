<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Akbura.Diagnostics.DiagnosticsWindow"
    Title="Akbura Diagnostics"
    Width="1220"
    Height="760"
    MinWidth="900"
    MinHeight="560"
    Background="#020617"
    WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="StackPanel.diagnostic-section">
            <Setter Property="Spacing" Value="10" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style Selector="TextBlock.diagnostic-section-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#94A3B8" />
        </Style>

        <Style Selector="Grid.diagnostic-value-row">
            <Setter Property="ColumnSpacing" Value="18" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <Style Selector="StackPanel.diagnostic-identity">
            <Setter Property="Spacing" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.diagnostic-name">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style Selector="TextBlock.diagnostic-detail">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>

        <Style Selector="TextBlock.diagnostic-value">
            <Setter Property="Foreground" Value="#CBD5E1" />
        </Style>

        <Style Selector="TextBlock.diagnostic-empty">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://Akbura/Styles.axaml" />
                <ResourceInclude Source="avares://Akbura.Diagnostics/Resources.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
    </Window.Resources>

</Window>
