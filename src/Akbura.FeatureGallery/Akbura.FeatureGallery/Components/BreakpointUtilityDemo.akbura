using Akbura.Markup;

<Border p-1
        ${sm}:p-2
        ${md}:p-3
        ${lg}:p-4
        ${xl}:p-5
        ${xxl}:p-6
        bg-slate-800
        border-1
        border-blue-500
        rounded-lg>

    <TextBlock
        Text="Resize the window. The largest active breakpoint controls this padding."
        text-slate-100
        whitespace-normal/>

</Border>
