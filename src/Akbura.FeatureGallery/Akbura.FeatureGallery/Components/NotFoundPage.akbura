using Akbura.FeatureGallery.Pages.Page.akcss;
using Akbura.Markup;

param string Url = "";
param Router Router;

<StackPanel gap-4
            self-center>

    <TextBlock Text="Page not found"
               page-title
               ${md}:page-title-desktop
               text-center/>

    <TextBlock Text={$"The page '{Url}' does not exist."}
               page-section-description
               text-center/>

    <Link Content="Go to Overview"
          Url="/overview"
          Router={Router}/>

</StackPanel>
