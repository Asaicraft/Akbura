using Akbura.Hooks;
using Akbura.FeatureGallery.Routing;

inject IRouter RouterService;

param Control? Content = null;
param IList<Page> Pages;
param IDataTemplate NotFound;

// A connected alias, not a second route owner. The diagnostics picker writes
// through this connection to the same service used by links and browser history.
state string url = bind RouteSource.Url;
state Control? content = null;

useEffect(() =>
{
    var page = Pages.FirstOrDefault(page =>
        string.Equals(
            page.Url,
            url,
            StringComparison.OrdinalIgnoreCase));

    content = page == null
        ? NotFound.Build(url)
        : TemplateContent
            .Load<Control>(page.Content)?
            .Result;

}, [url, Pages, NotFound]);

Content = content;

<ContentPresenter Content={Content}/>
