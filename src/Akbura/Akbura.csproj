<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Akbura</PackageId>
    <Title>Akbura</Title>
    <Description>Declarative UI language and incremental compiler for .NET and Avalonia, with reactive state and typed AKCSS styling.</Description>
    <PackageTags>avalonia;ui;declarative-ui;source-generator;akcss</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Configurations>Debug;Release;DebugStats;ReleaseStats</Configurations>
    <AkburaBuildTasksOutputDirectory>$(MSBuildThisFileDirectory)..\Akbura.Build.Tasks\bin\$(Configuration)\net10.0</AkburaBuildTasksOutputDirectory>
    <AkburaBuildTasksAssembly>$(AkburaBuildTasksOutputDirectory)\Akbura.Build.Tasks.dll</AkburaBuildTasksAssembly>
    <AkburaBlackSilenceOutputDirectory>$(MSBuildThisFileDirectory)..\Akbura.BlackSilence\bin\$(Configuration)\netstandard2.0</AkburaBlackSilenceOutputDirectory>
    <AkburaGeneratorOutputDirectory>$(MSBuildThisFileDirectory)..\Akbura.Generator\bin\$(Configuration)\netstandard2.0</AkburaGeneratorOutputDirectory>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAkburaBuildTasks;PackAkburaCompiler</TargetsForTfmSpecificContentInPackage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);AKBURA_RUNTIME</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akbura.Build.Tasks\Akbura.Build.Tasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Akbura.BlackSilence\Akbura.BlackSilence.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Styles.axaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Akbura.Generator\Pools\ImmutableArrayBuilder.cs"
             Link="Pools\ImmutableArrayBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="buildTransitive\\Akbura.targets" Pack="true" PackagePath="buildTransitive/Akbura.targets" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Import Project="buildTransitive\\Akbura.targets" />

  <Target Name="PackAkburaBuildTasks" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(AkburaBuildTasksOutputDirectory)\*.dll;$(AkburaBuildTasksOutputDirectory)\*.json">
        <PackagePath>tools/net10.0/%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="PackAkburaCompiler" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <TfmSpecificPackageFile
        Include="$(AkburaBlackSilenceOutputDirectory)\Akbura.BlackSilence.dll"
        PackagePath="analyzers/dotnet/cs/Akbura.BlackSilence.dll" />
      <TfmSpecificPackageFile
        Include="$(AkburaGeneratorOutputDirectory)\Akbura.Generator.dll"
        PackagePath="analyzers/dotnet/cs/Akbura.Generator.dll" />
    </ItemGroup>
  </Target>

</Project>
