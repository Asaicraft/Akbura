	// Typography for text and templated controls.
	TextBlock.text-left {
		TextAlignment: Left;
	}

	TextBlock.text-center {
		TextAlignment: Center;
	}

	TextBlock.text-right {
		TextAlignment: Right;
	}

	TextBlock.text-justify {
		TextAlignment: Justify;
	}

	TextBlock.text-start {
		TextAlignment: Start;
	}

	TextBlock.text-end {
		TextAlignment: End;
	}

	TextBlock.text-xs {
		FontSize: Amx.DynamicResource<double>("--text-xs");
	}

