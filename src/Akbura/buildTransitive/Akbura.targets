<Project>

	<PropertyGroup>
		<AkburaBlackSilenceDiagnostics Condition="'$(AkburaBlackSilenceDiagnostics)' == ''">Publish</AkburaBlackSilenceDiagnostics>
		<AkburaDiagnosticPublisher Condition="'$(AkburaDiagnosticPublisher)' == ''">Auto</AkburaDiagnosticPublisher>
	</PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="AkburaBlackSilenceDiagnostics" />
        <CompilerVisibleProperty Include="AkburaDiagnosticPublisher" />
        <CompilerVisibleProperty Include="DesignTimeBuild" />
        <CompilerVisibleProperty Include="AkburaWorkspaceDiagnosticsActive" />
    </ItemGroup>

	<PropertyGroup>
		<AkburaEmbedSourceFiles Condition="'$(AkburaEmbedSourceFiles)' == ''">true</AkburaEmbedSourceFiles>
		<AkburaBuildTasksAssembly Condition="'$(AkburaBuildTasksAssembly)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\Akbura.Build.Tasks.dll</AkburaBuildTasksAssembly>
	</PropertyGroup>

	<!-- Keep the task isolated from long-lived MSBuild nodes so its assemblies remain rebuildable. -->
	<UsingTask TaskName="Akbura.Build.GenerateAkburaModuleManifest"
			   AssemblyFile="$(AkburaBuildTasksAssembly)"
			   Runtime="NET"
			   Architecture="CurrentArchitecture"
			   TaskFactory="TaskHostFactory"
			   Condition="'$(AkburaEmbedSourceFiles)' == 'true'" />
	<UsingTask TaskName="Akbura.Build.CheckAkburaModuleManifest"
			   AssemblyFile="$(AkburaBuildTasksAssembly)"
			   Runtime="NET"
			   Architecture="CurrentArchitecture"
			   TaskFactory="TaskHostFactory"
			   Condition="'$(AkburaEmbedSourceFiles)' == 'true'" />

	<ItemGroup>
		<_AkburaModuleSource Include="**\*.akbura;**\*.akcss"
							 Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)">
			<LogicalName>$([System.String]::Copy('%(Identity)').Replace('\', '/'))</LogicalName>
		</_AkburaModuleSource>

		<!-- Keep source files as None items so Visual Studio can create and display them. -->
		<AdditionalFiles Include="@(_AkburaModuleSource)"
						 Exclude="@(AdditionalFiles)" />
	</ItemGroup>

	<!--
		Avalonia already injects AvaloniaXaml into AdditionalFiles when Roslyn
		requests analyzer inputs. Add only explicitly declared .axaml
		AvaloniaResource items here so they remain source-only editor facts and
		do not appear as AdditionalFiles in the evaluated Visual Studio project.
	-->
	<Target Name="_AkburaInjectAvaloniaResourceAdditionalFiles"
			AfterTargets="_InjectAdditionalFiles"
			BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun">
		<ItemGroup>
			<AdditionalFiles
				Include="@(AvaloniaResource->WithMetadataValue('Extension', '.axaml'))"
				Exclude="@(AdditionalFiles)"
				SourceItemGroup="AvaloniaResource" />
		</ItemGroup>
	</Target>

	<Target Name="_CheckAkburaModuleManifest"
		  DependsOnTargets="FindReferenceAssembliesForReferences;GenerateGlobalUsings;GenerateAssemblyInfo;GenerateTargetFrameworkMonikerAttribute"
		  Condition="'$(AkburaEmbedSourceFiles)' == 'true'
				   and '$(BuildingProject)' == 'true'
				   and '$(DesignTimeBuild)' != 'true'">

		<PropertyGroup>
			<AkburaModuleManifestPath Condition="'$(AkburaModuleManifestPath)' == ''">$(IntermediateOutputPath)Akbura.module.xml</AkburaModuleManifestPath>
		</PropertyGroup>

		<CheckAkburaModuleManifest
			Sources="@(_AkburaModuleSource)"
			CSharpSources="@(Compile)"
			References="@(ReferencePathWithRefAssemblies)"
			OutputPath="$(AkburaModuleManifestPath)"
			AssemblyName="$(AssemblyName)"
			RootNamespace="$(RootNamespace)"
			ProjectDirectory="$(MSBuildProjectDirectory)"
			ProjectPath="$(MSBuildProjectFullPath)"
			IntermediatePath="$(IntermediateOutputPath)"
			Configuration="$(Configuration)"
			TargetFramework="$(TargetFramework)"
			RuntimeIdentifier="$(RuntimeIdentifier)"
			DefineConstants="$(DefineConstants)"
			LanguageVersion="$(LangVersion)"
			Nullable="$(Nullable)"
			AllowUnsafeBlocks="$(AllowUnsafeBlocks)">
			<Output TaskParameter="RequiresGeneration" PropertyName="_AkburaManifestRequiresGeneration" />
			<Output TaskParameter="InputFingerprint" PropertyName="_AkburaManifestInputFingerprint" />
			<Output TaskParameter="CacheStatePath" PropertyName="_AkburaManifestCacheStatePath" />
			<Output TaskParameter="OutputLockPath" PropertyName="_AkburaManifestOutputLockPath" />
		</CheckAkburaModuleManifest>
	</Target>

	<Target Name="GenerateAkburaModuleManifest"
		  DependsOnTargets="_CheckAkburaModuleManifest"
		  Condition="'$(AkburaEmbedSourceFiles)' == 'true'
				   and '$(BuildingProject)' == 'true'
				   and '$(DesignTimeBuild)' != 'true'">

		<GenerateAkburaModuleManifest
			Condition="'$(_AkburaManifestRequiresGeneration)' == 'true'"
			InputFingerprint="$(_AkburaManifestInputFingerprint)"
			Sources="@(_AkburaModuleSource)"
			CSharpSources="@(Compile)"
			References="@(ReferencePathWithRefAssemblies)"
			OutputPath="$(AkburaModuleManifestPath)"
			AssemblyName="$(AssemblyName)"
			RootNamespace="$(RootNamespace)"
			ProjectDirectory="$(MSBuildProjectDirectory)"
			ProjectPath="$(MSBuildProjectFullPath)"
			IntermediatePath="$(IntermediateOutputPath)"
			Configuration="$(Configuration)"
			TargetFramework="$(TargetFramework)"
			RuntimeIdentifier="$(RuntimeIdentifier)"
			DefineConstants="$(DefineConstants)"
			LanguageVersion="$(LangVersion)"
			Nullable="$(Nullable)"
			AllowUnsafeBlocks="$(AllowUnsafeBlocks)" />
	</Target>

	<Target Name="_RegisterAkburaModuleResources"
		  BeforeTargets="AssignTargetPaths"
		  DependsOnTargets="GenerateAkburaModuleManifest"
		  Condition="'$(AkburaEmbedSourceFiles)' == 'true'
				   and '$(BuildingProject)' == 'true'
				   and '$(DesignTimeBuild)' != 'true'">

		<ItemGroup>
			<!-- Replace existing entries for our files rather than embedding them twice. -->
			<EmbeddedResource Remove="$(AkburaModuleManifestPath);@(_AkburaModuleSource)" />
			<EmbeddedResource Include="$(AkburaModuleManifestPath)">
				<LogicalName>!Akbura</LogicalName>
				<WithCulture>false</WithCulture>
				<Visible>false</Visible>
			</EmbeddedResource>

			<EmbeddedResource Include="@(_AkburaModuleSource)" />
			<FileWrites Include="$(AkburaModuleManifestPath);$(_AkburaManifestCacheStatePath);$(_AkburaManifestOutputLockPath)" />
		</ItemGroup>
	</Target>

</Project>
