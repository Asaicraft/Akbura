<Project>

	<PropertyGroup>
		<AkburaBlackSilenceDiagnostics Condition="'$(AkburaBlackSilenceDiagnostics)' == ''">Publish</AkburaBlackSilenceDiagnostics>
		<AkburaDiagnosticPublisher Condition="'$(AkburaDiagnosticPublisher)' == ''">Auto</AkburaDiagnosticPublisher>
	</PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="AkburaBlackSilenceDiagnostics" />
        <CompilerVisibleProperty Include="AkburaDiagnosticPublisher" />
        <CompilerVisibleProperty Include="DesignTimeBuild" />
        <CompilerVisibleProperty Include="AkburaWorkspaceDiagnosticsActive" />
    </ItemGroup>

	<PropertyGroup>
		<AkburaEmbedSourceFiles Condition="'$(AkburaEmbedSourceFiles)' == ''">true</AkburaEmbedSourceFiles>
		<AkburaModuleManifestPath Condition="'$(AkburaModuleManifestPath)' == ''">$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\Akbura.module.xml</AkburaModuleManifestPath>
		<AkburaBuildTasksAssembly Condition="'$(AkburaBuildTasksAssembly)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\Akbura.Build.Tasks.dll</AkburaBuildTasksAssembly>
	</PropertyGroup>

	<!-- Keep the task isolated from long-lived MSBuild nodes so its assemblies remain rebuildable. -->
	<UsingTask TaskName="Akbura.Build.GenerateAkburaModuleManifest"
			   AssemblyFile="$(AkburaBuildTasksAssembly)"
			   Runtime="NET"
			   Architecture="CurrentArchitecture"
			   TaskFactory="TaskHostFactory"
			   Condition="'$(AkburaEmbedSourceFiles)' == 'true'" />

	<ItemGroup>
		<_AkburaModuleSource Include="**\*.akbura;**\*.akcss"
							 Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)">
			<LogicalName>$([System.String]::Copy('%(Identity)').Replace('\', '/'))</LogicalName>
		</_AkburaModuleSource>

		<!-- Keep source files as None items so Visual Studio can create and display them. -->
		<AdditionalFiles Include="@(_AkburaModuleSource)"
						 Exclude="@(AdditionalFiles)" />
	</ItemGroup>

	<ItemGroup Condition="'$(AkburaEmbedSourceFiles)' == 'true'">
		<EmbeddedResource Include="$(AkburaModuleManifestPath)">
			<LogicalName>!Akbura</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<Target Name="GenerateAkburaModuleManifest"
		  BeforeTargets="AssignTargetPaths"
		  DependsOnTargets="FindReferenceAssembliesForReferences"
		  Condition="'$(AkburaEmbedSourceFiles)' == 'true'
				   and '$(BuildingProject)' == 'true'
				   and '$(DesignTimeBuild)' != 'true'">

		<RemoveDir
			Directories="$(IntermediateOutputPath)Akbura"
			Condition="Exists('$(IntermediateOutputPath)Akbura')" />
		<MakeDir
			Directories="$([System.IO.Path]::GetDirectoryName('$(AkburaModuleManifestPath)'))" />

		<GenerateAkburaModuleManifest
			Sources="@(_AkburaModuleSource)"
			CSharpSources="@(Compile)"
			References="@(ReferencePathWithRefAssemblies)"
			OutputPath="$(AkburaModuleManifestPath)"
			AssemblyName="$(AssemblyName)"
			RootNamespace="$(RootNamespace)"
			ProjectDirectory="$(MSBuildProjectDirectory)"
			DefineConstants="$(DefineConstants)"
			LanguageVersion="$(LangVersion)"
			Nullable="$(Nullable)"
			AllowUnsafeBlocks="$(AllowUnsafeBlocks)" />

		<ItemGroup>
			<EmbeddedResource Include="@(_AkburaModuleSource)" />
		</ItemGroup>
	</Target>

</Project>
