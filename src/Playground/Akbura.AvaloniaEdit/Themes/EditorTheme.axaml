          <SolidColorBrush x:Key="AkburaEditor.OperatorBrush" Color="#202020" />
          <SolidColorBrush x:Key="AkburaEditor.PunctuationBrush" Color="#202020" />
          <SolidColorBrush x:Key="AkburaEditor.MarkupTextBrush" Color="#A31515" />
          <SolidColorBrush x:Key="AkburaEditor.UtilityBrush" Color="#795E26" />
          <SolidColorBrush x:Key="AkburaEditor.UtilityModifierBrush" Color="#795E26" />
