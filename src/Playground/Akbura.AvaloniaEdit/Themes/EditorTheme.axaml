          <SolidColorBrush x:Key="AkburaEditor.StructNameBrush" Color="#267F99" />
          <SolidColorBrush x:Key="AkburaEditor.InterfaceNameBrush" Color="#267F99" />
          <SolidColorBrush x:Key="AkburaEditor.EnumNameBrush" Color="#267F99" />
          <SolidColorBrush x:Key="AkburaEditor.DelegateNameBrush" Color="#267F99" />
