<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AkburaEditor.KeywordBrush" Color="#0000BF" />
          <SolidColorBrush x:Key="AkburaEditor.NamespaceBrush" Color="#202020" />
          <SolidColorBrush x:Key="AkburaEditor.TypeBrush" Color="#267F99" />
          <SolidColorBrush x:Key="AkburaEditor.ComponentBrush" Color="#267F99" />
          <SolidColorBrush x:Key="AkburaEditor.AttributeBrush" Color="#7045A0" />
