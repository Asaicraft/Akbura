          <SolidColorBrush x:Key="AkburaEditor.LocalNameBrush" Color="#202020" />
          <SolidColorBrush x:Key="AkburaEditor.ParameterNameBrush" Color="#202020" />
          <SolidColorBrush x:Key="AkburaEditor.LabelNameBrush" Color="#202020" />
