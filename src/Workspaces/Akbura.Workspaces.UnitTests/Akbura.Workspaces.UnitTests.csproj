<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akbura.Workspaces\Akbura.Workspaces.csproj" />
    <ProjectReference Include="..\..\Akbura\Akbura.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Exercise the native host's production coordination without loading VS/WPF. -->
    <Compile Include="..\Akbura.VisualStudio\Projects\AkburaProjectContextManager.cs" Link="Native\AkburaProjectContextManager.cs" />
  </ItemGroup>

  <Import Project="..\..\Akbura.TestUtilities\Documentation\DocumentationExamples.props" />

</Project>
