using Akbura.Markup;
using Avalonia.Controls;
using Akbura.Styles.akcss;

<StackPanel gap-0 ${lg}:gap-4>
    <Border Height="48">
        <TextBlock Text="Primary content" />
    </Border>
    <Border Height="48" hidden ${lg}:visible>
        <TextBlock Text="Secondary details" />
    </Border>
</StackPanel>
